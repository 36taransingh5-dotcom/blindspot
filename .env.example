# Nebius Token Factory (OpenAI-compatible). Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Which Nemotron model plays which role. Run `npm run models` to list the IDs your key can use.
# Nano: fast per-step navigation decisions. Super: writing fixes. Ultra: diagnosing failures.
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily search, used to ground each fix in WCAG / ARIA guidance. https://tavily.com
TAVILY_API_KEY=

# Max agent steps per run
MAX_STEPS=30
